{
  "scripts": {
    "test": "jest",
    "test:unit": "jest",
    "test:coverage:unit": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:coverage:integration": "jest --config jest.integration.config.js --coverage",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:integration && tsx scripts/merge-coverage.ts",
    "build": "tsc && tsc-alias",
    "dev": "tsx watch src/server",
    "worker:dev": "tsx watch src/worker",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "knex --knexfile dist/src/lib/knex/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile src/lib/knex/knexfile.ts migrate:rollback",
    "migrate:status": "knex --knexfile src/lib/knex/knexfile.ts migrate:status",
    "migrate:make": "knex --knexfile src/lib/knex/knexfile.ts migrate:make"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "node-mailjet": "^6.0.11",
    "pg": "^8.19.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.10.0",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.0.2",
    "jest": "^30.5.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
