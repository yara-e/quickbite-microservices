# ==========================================
# Stage 1: Build Stage
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package management files
COPY package*.json ./

# Install all dependencies (including devDependencies)
RUN npm ci

# Copy configuration and source files
COPY tsconfig*.json ./
COPY src ./src

# Build TypeScript to dist
RUN npm run build

# Prune devDependencies to keep runtime small
RUN npm prune --omit=dev

# ==========================================
# Stage 2: Production Runtime
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

# Install tini for proper process signal handling
RUN apk add --no-cache tini

# Copy node_modules and compiled output from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

# Expose service port (adjust if order-service uses a different port)
EXPOSE 3001

# Run container as non-root user for security
USER node

# Start service
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/server.js"]