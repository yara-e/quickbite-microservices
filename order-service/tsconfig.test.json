{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "baseUrl": ".",
        "types": ["node", "jest"],
        "esModuleInterop": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src", "tests", "scripts"]
}